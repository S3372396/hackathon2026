# Copy to .env (gitignored) and fill in. Read by docker-compose.yml and tidecloak/setup.sh.

# TideCloak master-admin login, LOCAL DEVELOPMENT ONLY. Pick a strong value; never commit it.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Licensing a Tide realm ties it to an email address under Tide's Terms & Conditions
# (https://tide.org/legal). Only the person who owns this deployment may fill these in.
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=
