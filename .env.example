# Copy to .env (gitignored) and fill in. Read by tidecloak/setup.sh, tidecloak/docker-compose.yml
# and the server. Development values only; never commit .env.

# TideCloak master-admin login, LOCAL DEVELOPMENT ONLY. Pick a strong value.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Licensing a Tide realm ties it to an email address under Tide's Terms & Conditions
# (https://tide.org/legal). Only the person who owns this deployment may fill these in.
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

# Server settings (optional; these are the defaults).
# PORT=3001
# DB_PATH=server/data/journal.db
# TIDECLOAK_ADAPTER=tidecloak/tidecloak.json
# Origins the browser may call the API from: used for CORS and for checking DPoP proofs.
# WEB_ORIGIN=http://localhost:5173
# PUBLIC_ORIGINS=http://localhost:3001,http://localhost:5173
